{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"E:/ProyectosIA/wallpaper/hooks/cc_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"E:/ProyectosIA/wallpaper/hooks/cc_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"E:/ProyectosIA/wallpaper/hooks/cc_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"E:/ProyectosIA/wallpaper/hooks/cc_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"E:/ProyectosIA/wallpaper/hooks/cc_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"E:/ProyectosIA/wallpaper/hooks/cc_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
